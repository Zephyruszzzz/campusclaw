# 可选文件：**不设置任何环境变量也能直接 `python app.py` 启动并登录**，
# 此时使用代码内置的测试凭据（见 README「预置账号」）。
#
# 本文件只用于覆盖内置默认值。用法：复制为 .env 后填写。
#   PowerShell:  Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会进入版本库，也**不需要**存在——
# `docker compose up` 与 `python app.py` 在没有它时同样可以正常运行。

# 会话签名密钥：任意非空白随机字符串。留空则使用内置开发密钥。
SECRET_KEY=

# 四个预置账号的初始口令：UTF-8 字节长度须为 8～72。
# 留空则使用内置测试口令；若填写但长度非法，初始化会被拒绝。
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=
SEED_TEACHER_B_PASSWORD=

# 可选：HTTPS 部署时必须为 true，会话 Cookie 将附加 Secure 属性。
AUTH_COOKIE_SECURE=false

# 可选：设为 1 启用严格模式——SECRET_KEY 或种子口令缺失时直接启动失败，
# 不再回落到内置默认值。正式环境建议开启。
# CAMPUSCLAW_STRICT_CONFIG=1

# 可选：仅 Docker Compose 使用，改宿主机映射端口（容器内固定 8080）。
# CAMPUSCLAW_PORT=8080
