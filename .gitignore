# ---------------------------------------------------------------------------
# 运行时产物与敏感配置：不入库
# ---------------------------------------------------------------------------
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 持久化数据：保留在宿主机，不入库
data/
uploads/
*.db
*.sqlite3
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# 本机 / 工具链杂项
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.log

# 编辑器与智能体工具的工作目录
.codebuddy/
.claude/
.workbuddy/

# 本地排障过程中的临时探针文件
docs/_*
docs/screenshots/_*

# 截图工具路径转义异常产生的文件（文件名本身是 Windows 绝对路径，分隔符被剥离）
Users*Desktop*
